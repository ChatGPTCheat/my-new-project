bool dogs(const std::string& gname, std::string& name) {
     
    if (gname.find("AIMob_PatrolDog_C") != std::string::npos) 
    {
        name = "DOG";
        
        return true;
    }
    if (gname.find("BPPawn_HungerB_C") != std::string::npos) 
    {
        name = "DOG";
        
        return true;
    }
        if (gname.find("BP_MechaAI_C") != std::string::npos) 
    {
        name = "Mech Robot";
        
        return true;
    }
    if (gname.find("BPPawn_Library_C") != std::string::npos) 
    {
        name = "Library boss";
        
        return true;
    }
    if (gname.find("BPPawn_HungerH_C") != std::string::npos) 
    {
        name = "DOG";
        
        return true;
    }
    if (gname.find("BPPawn_Watcher_C") != std::string::npos) 
    {
        name = "DOG";
        
        return true;
    }
    if (gname.find("BPPawn_VenomVariant_C") != std::string::npos) 
    {
        name = "Boss";
        
        return true;
    }
    if (gname.find("BPPawn_BurningVariant_C") != std::string::npos) 
    {
        name = "BOSS";
        
        return true;
    }
    
    return false;
}










