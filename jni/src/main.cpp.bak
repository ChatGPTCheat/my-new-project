bool IsAimLongAim = false;
char AimName[32];
int Aimchoose = (int)NumIo[21];


int findminat()
{
using namespace std;
std::srand(std::time(0));
    float min = NumIo[3];
	float DistanceMin = NumIo[17];
    float minDistance = NumIo[19]; // 设置自瞄的最小距离为150米
    int minAt = 999;
    for (int i = 0; i < MaxPlayerCount; i++)
    {
		switch ((int)NumIo[21])
        {
            case 0:
    if (IsAimLongAim) {
			if (strcmp(Aim[i].Name, AimName) == 0)
    		{           	
        			minAt = i;
    			}
		} else {
    			if (Aim[i].ScreenDistance < min && Aim[i].ScreenDistance < minDistance < NumIo[3] )
    			{
					if (DrawIo[30]) {
						strcpy(AimName, Aim[i].Name);
					}
        			min = Aim[i].ScreenDistance;
        			minAt = i;
    			}
		}
	break;
case 1:
    if (IsAimLongAim) {
			if (strcmp(Aim[i].Name, AimName) == 0)
    		{           	
        			minAt = i;
    			}
		} else {
    			if //(Aim[i].WodDistance < DistanceMin && Aim[i].WodDistance < minDistance < NumIo[3])
    			
    			(Aim[i].WodDistance < DistanceMin&&Aim[i].ScreenDistance < NumIo[3])
    			
    			
    			
    			{
    			
					if (DrawIo[30]) {
						strcpy(AimName, Aim[i].Name);
					}
        			DistanceMin = Aim[i].WodDistance;
        			minAt = i;
				}
    		}
    break;

		}
    }
    if (minAt == 999)
    {
        Gmin = -1;
		IsAimLongAim = false;
        return -1;
    }
    Gmin = minAt;   
    Aim[minAt].WodDistance;
	if (DrawIo[30]) {
		IsAimLongAim = true;
	}
    return minAt;
}

