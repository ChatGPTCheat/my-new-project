                        // Global variables
static int recordingDuration = 30; // Default time is 30 seconds
static std::atomic<bool> isRecording(false); // Recording flag
static std::atomic<int> recordingTimeElapsed(0); // Elapsed recording time

    if (ImGui::Button("Start rec", ImVec2(236.0f, 75.0f))) {
        if (!isRecording.load()) {
            isRecording.store(true);
            recordingTimeElapsed.store(0); // Reset time when starting





// ...


std::thread([=]() {
    // Non-blocking start recording
    std::string command = "screenrecord --time-limit " + std::to_string(recordingDuration) + " /sdcard/DCIM/" + randomVideoName + " &";
    int result = system(command.c_str());
    
    if (result == -1) {
        std::cerr << "Failed to start recording" << std::endl;
        isRecording.store(false);
        return;
    }

    for (int i = 0; i < recordingDuration && isRecording.load(); ++i) {
        std::this_thread::sleep_for(std::chrono::seconds(1));
        recordingTimeElapsed.fetch_add(1);
    }

    isRecording.store(false);
}).detach();




        }
    }

    if (isRecording.load()) {
        int elapsed = recordingTimeElapsed.load();
        std::string watermarkText = "Time: " + std::to_string(elapsed) + " s";
        
        // Set window transparency
        ImGui::SetNextWindowBgAlpha(0.4f); // 40% transparent
        // Set window position
        ImGui::SetNextWindowPos(ImVec2(1060, 10)); // For example, position at (1060, 10)
        
        // Create window
        ImGui::Begin("RecordingTimeWindow", nullptr, ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_AlwaysAutoResize);
        ImGui::Text("%s", watermarkText.c_str());
        ImGui::End();
    }

    ImGui::SameLine();

    if (ImGui::Button("Stop rec", ImVec2(236.0f, 75.0f)) && isRecording.load()) {
        system("pkill -l SIGINT screenrecord");
        isRecording.store(false);
    }
    
    

    ImGui::SliderInt("Time limit", &recordingDuration, 1, 180);  // Slider to set custom recording duration

                        
                        
                        
