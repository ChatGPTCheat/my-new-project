            if (DrawIo[3]) {
    const ImColor YELLOW = ImColor(255, 255, 0);
    const ImColor GOLDEN_GLOW = ImColor(255, 215, 0, 100);
    const ImColor GOLDEN = ImColor(218, 165, 32);
    const ImColor LINE_COLOR = ImColor(255, 255, 0, 200);
    auto isValidBone = [](const Vec2& pos) {
        return pos.x > 0 && pos.y > 0 && pos.x < screen_x && pos.y < screen_y;
    };
    if (isValidBone(temp->mPlayerArray.mPlayer[i].Head.ScreenPos)) {
        Draw->AddCircle({temp->mPlayerArray.mPlayer[i].Head.ScreenPos.x, temp->mPlayerArray.mPlayer[i].Head.ScreenPos.y}, temp->mPlayerArray.mPlayer[i].w / 6 + 2.0f, GOLDEN_GLOW, 100, 2.5f);
        Draw->AddCircleFilled({temp->mPlayerArray.mPlayer[i].Head.ScreenPos.x, temp->mPlayerArray.mPlayer[i].Head.ScreenPos.y}, temp->mPlayerArray.mPlayer[i].w / 8, GOLDEN);
        Draw->AddCircleFilled({temp->mPlayerArray.mPlayer[i].Head.ScreenPos.x, temp->mPlayerArray.mPlayer[i].Head.ScreenPos.y}, temp->mPlayerArray.mPlayer[i].w / 12, YELLOW);
        Draw->AddCircleFilled({temp->mPlayerArray.mPlayer[i].Head.ScreenPos.x, temp->mPlayerArray.mPlayer[i].Head.ScreenPos.y}, temp->mPlayerArray.mPlayer[i].w / 16, ImColor(255, 255, 0));
    }
    auto DrawCyberBone = [&](const Vec2& from, const Vec2& to) {
        if (isValidBone(from) && isValidBone(to)) {
            Draw->AddLine({from.x, from.y}, {to.x, to.y}, LINE_COLOR, 2.0f);
        }
    };

    DrawCyberBone(temp->mPlayerArray.mPlayer[i].Head.ScreenPos, temp->mPlayerArray.mPlayer[i].Chest.ScreenPos);
