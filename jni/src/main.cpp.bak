    auto DrawCyberJoint = [&](const Vec2& pos, float size) {
        if (isValidBone(pos)) {
            Draw->AddCircleFilled({pos.x, pos.y}, size*1.3f, GOLDEN_GLOW);
            Draw->AddCircleFilled({pos.x, pos.y}, size, YELLOW);
            Draw->AddCircleFilled({pos.x-size/4, pos.y-size/4}, size/5, ImColor(255,255,0,200));
        }
    };

    const float JOINT_SIZE = temp->mPlayerArray.mPlayer[i].w / 30;
