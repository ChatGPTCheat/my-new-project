    if (isValidBone(temp->mPlayerArray.mPlayer[i].Chest.ScreenPos)) DrawCyberJoint(temp->mPlayerArray.mPlayer[i].Chest.ScreenPos, SMALLER_JOINT_SIZE);
    if (isValidBone(temp->mPlayerArray.mPlayer[i].Pelvis.ScreenPos)) DrawCyberJoint(temp->mPlayerArray.mPlayer[i].Pelvis.ScreenPos, SMALLER_JOINT_SIZE);
