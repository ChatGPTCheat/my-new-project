int heighjxy;
void DrawHealth(Vec2 box, float entityHealth)
{
    float x = box.x;
    float y = box.y - 20; // смещаем Y-координату вверх на 20 пикселей

    int curHp = (int)std::max(0, std::min((int)entityHealth, 100));

    float hpBarWidth = 60.8f; // ширина полоски HP

    float fillAmount = curHp / 100.0f;

    ImColor HPColor = curHp < 70? curHp < 55? curHp < 35? ImColor(255, 0, 0, 255) : ImColor(255, 165, 0, 255) : ImColor(255, 255, 0, 255) : ImColor(0, 255, 0, 255);

    // Draw the HP bar with the fixed width and fill amount
    ImGui::GetForegroundDrawList()->AddRectFilled({x - (hpBarWidth / 2) - 3, y - 10}, {x - (hpBarWidth / 2) + fillAmount * hpBarWidth - 3, y - 2}, HPColor, 0, 0);
    ImGui::GetForegroundDrawList()->AddRect({x - (hpBarWidth / 2) - 3, y - 10}, {x + (hpBarWidth / 2) - 3, y - 1}, ImColor(0, 0, 0, 255), 0, 0, 1.3f);
}


void DrawInfo(Vec2 box, float entityHealth)
{
    float cornerRadius = 0.5f;
    float x = box.x;
    float y = box.y;

    int curHp = (int)std::max(0, std::min((int)entityHealth, 100));

    float totalLength = 180.0f;
    float leftEdge = x - (totalLength / 2);
    float rightEdge = x + (totalLength / 2);

    ImColor textColor = ImColor(255, 255, 255, 255); // white text color

    // Calculate the fixed width of the HP bar
    float hpBarWidth = 50.8f; // adjust this value to your liking

    // Calculate the fill amount based on the current health value
    float fillAmount = curHp / 100.0f;

    ImColor HPColor = curHp < 70? curHp < 55? curHp < 35? ImColor(255, 0, 0, 255) : ImColor(255, 165, 0, 255) : ImColor(255, 255, 0, 255) : ImColor(0, 255, 0, 255);

    // Draw the HP bar with the fixed width and fill amount
    ImGui::GetForegroundDrawList()->AddRectFilled({x - (hpBarWidth / 2) - 3, y - 36 + 2}, {x - (hpBarWidth / 2) + fillAmount * hpBarWidth - 3, y - 28 + 2}, HPColor, 0, 0);
    ImGui::GetForegroundDrawList()->AddRect({x - (hpBarWidth / 2) - 3, y - 36 + 2}, {x + (hpBarWidth / 2) - 3, y - 27 + 2}, ImColor(0, 0, 0, 255), 0, 0, 1.3f);
}

void DrawText(const char* text, float x, float y, ImColor color)
{
    ImGui::GetForegroundDrawList()->AddText(
        NULL,
        15.0f,
        ImVec2(x, y),
        color,
        text
    );
}

void DrawTeam(Vec2 box, float w, uint32_t TeamID, const char* name)
{
    float x = box.x - (140 - w) / 2;
    float y = box.y;
    char TeamText[50];
    snprintf(TeamText, sizeof(TeamText), "[ %d ] -  %s", TeamID, name);





    if (DrawIo[4]) {
    float textWidth = ImGui::CalcTextSize(TeamText).x;
    float textPosX = x - textWidth / 2 + 100 ;  
    float textPosY = y - 50;

    float outlineThickness = 2.0f;  

    
    DrawText(TeamText, textPosX - outlineThickness, textPosY - outlineThickness, ImColor(0, 0, 0, 255));
    DrawText(TeamText, textPosX + outlineThickness, textPosY - outlineThickness, ImColor(0, 0, 0, 255));
    DrawText(TeamText, textPosX - outlineThickness, textPosY + outlineThickness, ImColor(0, 0, 0, 255));
    DrawText(TeamText, textPosX + outlineThickness, textPosY + outlineThickness, ImColor(0, 0, 0, 255));

    
    DrawText(TeamText, textPosX, textPosY, ImColor(255, 255, 255, 255));
}

}

ImColor BoneDrawColor;



#include <vector>
#include <algorithm> // 用于 std::reverse

struct ImVec3 {
    float x, y, z;
};

void Parabola(Vec3 obj, ImColor color, float thickness ) {
    static std::vector<Vec3> grenadePath; 
    
    Vec3 newGrenadePosition;
    newGrenadePosition = obj;
    grenadePath.push_back(newGrenadePosition);
    if (grenadePath.size() > 250) {
        grenadePath.erase(grenadePath.begin(), grenadePath.begin() + grenadePath.size() - 250);
    }
      Vec2 screenPos;
    std::vector<Vec2> screenPath; 
    for (const Vec3& pos : grenadePath) {
          WorldToScreen(&screenPos ,pos);
          screenPath.push_back(screenPos);
    }
    if (screenPath.size() > 1) {
          std::reverse(screenPath.begin(), screenPath.end());
        for (size_t i = 0; i < screenPath.size() - 1; ++i) {
       
            ImGui::GetForegroundDrawList()->AddCircleFilled({screenPath[i].x, screenPath[i].y}, 3, color, thickness);

        }
    }
}


void krug(Vec2 Obj, float camear, ImColor color, float Radius, float distance)
{
    ImRect screen_rect = {0.0f, 0.0f, screen_x, screen_y};
    auto screen_center = screen_rect.GetCenter();
    auto angle = atan2(screen_center.y - Obj.y, screen_center.x - Obj.x);
    angle += camear > 0 ? M_PI : 0.0f;
    Vec2 arrow_center {
        screen_center.x + Radius * cosf(angle),
        screen_center.y + Radius * sinf(angle)
    };
    std::array<ImVec2, 4>points {
        ImVec2(-22.0f, -8.6f),
        ImVec2(0.0f, 0.0f),
        ImVec2(-22.0f, 8.6f),
        ImVec2(-18.0f, 0.0f)
    };
    for (auto & point : points)
    {
        auto x = point.x * 1.155f;
        auto y = point.y * 1.155f;
        point.x = arrow_center.x + x * cosf(angle) - y * sinf(angle);
        point.y = arrow_center.y + x * sinf(angle) + y * cosf(angle);
    }
    float alpha = 1.0f;
    if (camear > 0)
    {
        constexpr float nearThreshold = 200 * 200;
        ImVec2 screen_outer_diff = {
            Obj.x < 0 ? abs(Obj.x) : (Obj.x > screen_rect.Max.x ? Obj.x - screen_rect.Max.x : 0.0f),
            Obj.y < 0 ? abs(Obj.y) : (Obj.y > screen_rect.Max.y ? Obj.y - screen_rect.Max.y : 0.0f),
        };
        float distance_alpha = static_cast<float>(pow(screen_outer_diff.x, 2) + pow(screen_outer_diff.y, 2));
        alpha = camear < 0 ? 1.0f : (distance_alpha / nearThreshold);
    }
    ImColor arrowColor = color;
    arrowColor.Value.w = std::min(alpha, 1.0f);
    ImGui::GetBackgroundDrawList()->AddTriangleFilled(points[0], points[1], points[3], arrowColor);
    ImGui::GetBackgroundDrawList()->AddTriangleFilled(points[2], points[1], points[3], arrowColor);
    ImGui::GetBackgroundDrawList()->AddQuad(points[0], points[1], points[2], points[3], ImColor(0.0f, 0.0f, 0.0f, alpha), 1.335f);

    // Draw distance text
    char distance_text[30];
sprintf(distance_text, "%d", static_cast<int>(distance));
    ImVec2 text_pos = ImVec2(points[1].x, points[1].y);
   // ImGui::GetBackgroundDrawList()->AddText(text_pos, ImColor(255, 255, 10, 255), distance_text);
ImGui::GetBackgroundDrawList()->AddText(ImGui::GetIO().Fonts->Fonts[0], 22.0f, text_pos, ImColor(255, 255, 10, 255), distance_text);
}


