// Forward declaration of the function
float CalculateScreenDistance(const ScreenPos& pos, float centerX, float centerY);

// Function definition
float CalculateScreenDistance(const ScreenPos& pos, float centerX, float centerY) {
    return sqrt(pow(centerX - pos.x, 2) + pow(centerY - pos.y, 2));
}

// Assuming Vec3 and Vector3 are defined as follows:
struct Vec3 {
    float x, y, z;
};

struct Vector3 {
    float x, y, z;

    // Constructor for converting Vec3 to Vector3
    Vector3(const Vec3& vec) : x(vec.x), y(vec.y), z(vec.z) {}
};

