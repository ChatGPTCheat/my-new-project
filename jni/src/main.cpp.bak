std::string GetCurrentTime() {
    std::time_t time = std::time(0);   
    std::tm* now = std::localtime(&time);

    char buffer[80];
    std::strftime(buffer, 80, "%Y-%m-%d %H:%M:%S", now);   

    return buffer;
}



