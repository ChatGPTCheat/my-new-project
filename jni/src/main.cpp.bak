        Aim[AimCount].AimMovement = temp->mPlayerArray.mPlayer[i].Predict;

        // Determine the target position based on NumIo[8]
        Vector3 targetPosition;
        float screenDistance;

        // Convert NumIo[8] to int for switch
        int targetType = static_cast<int>(NumIo[8]);

        switch (targetType) {
            case 1: // Head
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Head.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Head.ScreenPos, screen_x, screen_y);
                break;
            case 2: // Chest
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Chest.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Chest.ScreenPos, screen_x, screen_y);
                break;
            case 3: // Pelvis                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Pelvis.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Pelvis.ScreenPos, screen_x, screen_y);
                break;
            case 4: // Left Shoulder
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Left_Shoulder.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Left_Shoulder.ScreenPos, screen_x, screen_y);
                break;
            case 5: // Right Shoulder
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Right_Shoulder.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Right_Shoulder.ScreenPos, screen_x, screen_y);
                break;
            case 6: // Left Elbow
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Left_Elbow.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Left_Elbow.ScreenPos, screen_x, screen_y);
                break;
            case 7: // Right Elbow
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Right_Elbow.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Right_Elbow.ScreenPos, screen_x, screen_y);
                break;
            case 8: // Left Wrist
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Left_Wrist.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Left_Wrist.ScreenPos, screen_x, screen_y);
                break;
            case 9: // Right Wrist
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Right_Wrist.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Right_Wrist.ScreenPos, screen_x, screen_y);
                break;
            case 10: // Left Thigh
                targetPosition = Vector3(temp->mPlayerArray.mPlayer[i].Left_Thigh.Pos);
                screenDistance = CalculateScreenDistance(temp->mPlayerArray.mPlayer[i].Left_Thigh.ScreenPos, screen_x, screen_y);
                break;
            default:
                continue; // Skip if no valid target is found
        }

        Aim[AimCount].ObjAim = targetPosition;
        Aim[AimCount].ScreenDistance = screenDistance;
        AimCount++; // Increment AimCount after storing data
    }



            left  = temp->mPlayerArray.mPlayer[i].Head.ScreenPos.x - temp->mPlayerArray.mPlayer[i].w * 0.6;
