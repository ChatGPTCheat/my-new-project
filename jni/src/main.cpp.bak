#include "Pictureconfiguration.h"
#include <墨勋.h>
ImTextureID LOGO图片;
void 加载图片(ImVec2 center, float size)
{
    ImGui::SetCursorPos({0, 180});
    ImDrawList *draw_list = ImGui::GetWindowDrawList();
    draw_list->AddImage(LOGO图片, {center.x + size / 1, center.y + size / 1}, {center.x + size / 1, center.y + size / 1});
}

void DrawLogo(ImVec2 center, float size) {
ImGui::SetCursorPos({0, 180});
ImGui::SetCursorPos({0, 180});
ImDrawList *draw_list = ImGui::GetWindowDrawList();
draw_list->AddImage(LOGO图片,{center.x - size /1,center.y - size / 1},{center.x + size / 1,center.y + size / 1});
}


