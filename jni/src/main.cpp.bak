        ((DrawIo[32] && temp->mPlayerArray.mPlayer[i].Health > 0) || !DrawIo[32])) {
        
        // Store player information for aiming
        strcpy(Aim[AimCount].Name, temp->mPlayerArray.mPlayer[i].PlayerName);
