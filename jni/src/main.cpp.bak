        Draw->AddText(NULL, 45, {screen_x/2 - 100, 120}, ImColor(255, 0, 0), "@Zalypa_kernel 4.0");
    }
} else {
    string countStr = to_string(PlayerCount) + to_string(BotCount);
    auto textSizes = ImGui::CalcTextSize(countStr.c_str(), 0, 35);
    float left = screen_x / 2 - rectWidth / 2 - deltaWidth;
    float right = screen_x / 2 + rectWidth / 2 + deltaWidth;
    Draw->AddRectFilled({left, 30}, {right, 120}, ImColor(0, 255, 255, 120), {60});
    Draw->AddRectFilled({screen_x/2 - 90, 30}, {screen_x/2 + 90, 120}, ImColor(0, 255, 255, 0), {60});
    Draw->AddText(NULL, 42, ImVec2(screen_x/2 - 60, 55), ImColor(255, 0, 0, 255), to_string(PlayerCount).c_str());
    Draw->AddText(NULL, 42, ImVec2(screen_x/2 + 42, 55), ImColor(255, 255, 255, 255), to_string(BotCount).c_str());
}











